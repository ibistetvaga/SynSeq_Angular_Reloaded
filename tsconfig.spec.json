/* To learn more about Typescript configuration file: https://www.typescriptlang.org/docs/handbook/tsconfig-json.html. */
/* To learn more about Angular compiler options: https://angular.dev/reference/configs/angular-compiler-options. */
{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "./out-tsc/spec",
    "types": [
      "vitest/globals"
    ]
  },

  /*
   * BOTH projects, one runner.
   *
   * `@angular/build:unit-test` resolves specs through a build target, and a
   * library project does not have one - so the old per-project Karma targets
   * could not survive the migration as a pair. The app's target now owns every
   * spec in the workspace, and the library's specs reach its source through
   * the `paths` mapping in the root config.
   */
  "include": [
    "src/**/*.d.ts",
    "src/**/*.spec.ts",
    "projects/**/*.spec.ts"
  ]
}
